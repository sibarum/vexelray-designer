<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.designer</groupId>
    <artifactId>vexelray-designer</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>vexelray-designer</name>
    <description>
        A parametric SDF design tool on vexelray-gui: an object/modifier tree in one window, a ray-marched
        viewport in another. Standalone client app - depends on the framework from the local Maven repo and
        selects its platform modules via OS-activated profiles, the same shape as calculator-vexel-demo.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
        <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
        <tactroller.version>1.0-SNAPSHOT</tactroller.version>
        <vexelray-framework.version>0.1.0-SNAPSHOT</vexelray-framework.version>

        <app.mainClass>dev.vexelray.designer.DesignerApp</app.mainClass>
        <!-- Program args for exec:exec (one token each; empty = interactive). -->
        <app.args></app.args>
        <app.args2></app.args2>
        <app.args3></app.args3>
        <!-- Diagnostics: mvn compile exec:exec "-Dwake.trace=true" traces every frame-loop wake. -->
        <wake.trace>false</wake.trace>

        <!--
          Profiling: verbose on demand, across the whole stack. See sibarum.probe.Probe and
          atchung/docs/probe.md.

            mvn compile exec:exec -Pprofiler                      everything, rollup every 2s, slow frames named
            mvn compile exec:exec "-Dprobe=frame,gpu,shader"      three lanes only
            mvn compile exec:exec -Pprofiler "-Dprobe.out=run.log"  to a file instead of stdout

          Lanes: bus state time anim input frame layout draw gpu shader app. For this application `shader` and
          `gpu` are the two that matter - a scene change is a lowering and a pipeline build, and that is the
          cost R1 and R4 exist to remove, so it should be measured rather than argued about.

          Every one is also an environment variable - PROBE, PROBE_OUT, PROBE_TRACE, PROBE_EVERY, PROBE_SLOW,
          PROBE_STACKS - which works identically on every OS and needs no Maven.
        -->
        <probe>off</probe>
        <probe.out></probe.out>
        <probe.trace>false</probe.trace>
        <probe.every>0</probe.every>
        <probe.slow>0</probe.slow>
        <probe.stacks>false</probe.stacks>
        <probe.format>text</probe.format>

        <!--
          The automation driver: "off", "on" for the default port, or a port number. The tree window takes the
          port named and the viewport window the one above it, because a marched picture cannot be checked by
          reading numbers and each driver is bound to its own Gui tree.
          See vexelray-gui/docs/automation.md and docs/driving-the-viewport.md.
        -->
        <automation>off</automation>
    </properties>

    <dependencies>
        <!-- The application edge: phases, the frame loop, input, window memory, argument parsing. What used to
             be the top 200 lines of DesignerApp. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- The driving socket, wired once instead of by hand. A module of its own because it links a listening
             socket, so an application says whether it wants one - and this one does: see drivers() in
             DesignerWiring for the second socket it still binds for itself. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- Driving the running app the way a person does: real window, real Vulkan, real frame loop. A
             troubleshooting instrument, not a shipped feature - see vexelray-gui/docs/automation.md. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The framework: nodes, layout, dispatch, windows, and the widgets (TreeView above all). -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Pictures: the grid overlay on the viewport is marks in a box, not two hundred floating nodes. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-draw</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Camera. The march takes its eye from here and so does the grid overlay, which is what makes the
             two agree by construction rather than by two derivations that happen to match. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-plot</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The surface compiler and the ray-march composer. Brings vexelray-surface and vexelray-ir behind it. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-technique-sdf</artifactId>
            <version>${vexelray.version}</version>
        </dependency>
        <!-- Input at the application edge: the tactroller->atchung bridge. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <target>${maven.compiler.release}</target>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <!-- Run: mvn compile exec:exec ; a bounded run that exits on its own: mvn compile exec:exec "-Dapp.args=3" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-Dvexelray.wake.trace=${wake.trace}</argument>
                        <argument>-Dprobe=${probe}</argument>
                        <argument>-Dprobe.out=${probe.out}</argument>
                        <argument>-Dprobe.trace=${probe.trace}</argument>
                        <argument>-Dprobe.every=${probe.every}</argument>
                        <argument>-Dprobe.slow=${probe.slow}</argument>
                        <argument>-Dprobe.stacks=${probe.stacks}</argument>
                        <argument>-Dprobe.format=${probe.format}</argument>
                        <argument>-Dautomation=${automation}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${app.mainClass}</argument>
                        <argument>${app.args}</argument>
                        <argument>${app.args2}</argument>
                        <argument>${app.args3}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Everything, rolled up every two seconds, with slow frames named as they happen. -->
        <profile>
            <id>profiler</id>
            <properties>
                <probe>all</probe>
                <probe.every>2000</probe.every>
                <probe.slow>16</probe.slow>
                <probe.stacks>true</probe.stacks>
            </properties>
        </profile>
        <!-- Build-time platform selection, same as vexelray-gui-demo and calculator-vexel-demo. -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
